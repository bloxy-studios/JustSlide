<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Development build: hardened runtime, App Sandbox OFF so the agent IPC
     socket in Application Support is reachable by justslide-mcp. Sandboxing
     with an app-group socket is a tracked release item (docs/security-and-privacy.md). -->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key><false/>
	<key>com.apple.security.network.client</key><true/>
</dict>
</plist>
