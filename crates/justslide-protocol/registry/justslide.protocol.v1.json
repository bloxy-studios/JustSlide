      },
      "result": {
        "type": "object",
        "required": [
          "tabId",
          "mimeType",
          "dataBase64",
          "width",
          "height",
          "navigationId"
        ],
        "properties": {
          "tabId": {
            "type": "string"
          },
          "mimeType": {
            "type": "string"
          },
          "dataBase64": {
            "type": "string"
          },
          "width": {
            "type": "integer"
          },
          "height": {
            "type": "integer"
          },
          "navigationId": {
            "type": "string"
          }
        }
      },
      "events": [],
      "exposure": [
        "mcp",
        "ui"
      ]
    },
    {
      "name": "events.poll",
      "mcpTool": "justslide_events_poll",
      "title": "Poll browser events",
      "description": "Return sanitized events after a sequence number for resynchronization. If `resyncRequired` is true the client must re-list state.",
      "operation": "read.metadata",
      "idempotency": "safe",
      "activates": false,
      "arguments": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "afterSeq": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "max": {
            "type": "integer",
