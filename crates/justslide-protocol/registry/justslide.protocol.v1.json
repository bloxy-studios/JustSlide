{
  "$comment": "Canonical JustSlide local-automation + chrome command registry (WebKit edition). Single source of truth for command names, argument/result schemas, permission categories, events, errors and limits. Consumed by crates/justslide-protocol (Rust, embedded), crates/justslide-mcp (tool surface) and apps/browser-chrome (generated TypeScript via scripts/gen-protocol-ts.mjs). exposure=mcp: callable by authenticated agents (subject to grants). exposure=ui: trusted browser chrome only (human actor).",
  "protocol": "app.justslide.local-automation",
  "version": "1.1.0",
  "framing": {
    "transport": "unix-domain-socket",
    "encoding": "utf-8 JSON",
    "frame": "u32 big-endian byte length followed by one JSON object",
    "maxFrameBytes": 65536,
    "maxResultFrameBytes": 8388608
  },
  "limits": {
    "maxConcurrentRequestsPerConnection": 8,
    "maxQueuedEventsPerConnection": 1024,
    "maxTabsCreatedPerMinute": 30,
    "maxSnapshotNodes": 2000,
    "maxSnapshotTextBytes": 262144,
    "maxScreenshotEdgePx": 2560,
    "requestTimeoutMs": 30000
  },
  "handshake": {
    "hello": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "hello"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "hello": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "client",
            "clientVersion",
            "pairingToken"
          ],
          "properties": {
            "client": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
            },
            "clientVersion": {
              "type": "string",
              "maxLength": 32
            },
            "pairingToken": {
              "type": "string",
              "minLength": 43,
              "maxLength": 128
            },
            "expectInstanceId": {
              "type": "string",
              "maxLength": 64
            }
          }
        }
      }
    },
    "welcome": {
      "type": "object",
      "required": [
        "v",
        "welcome"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "welcome": {
          "type": "object",
          "required": [
            "instanceId",
            "protocolVersion",
            "grantId",
            "commands"
          ],
          "properties": {
            "instanceId": {
              "type": "string"
            },
            "protocolVersion": {
              "type": "string"
            },
            "grantId": {
              "type": "string"
            },
            "commands": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "notes": "The browser resolves actor identity from the peer credentials of the socket (same uid) and the pairing record matched by the token. No caller-supplied actor/agent id is ever trusted. `welcome.commands` lists only commands implemented by this browser build AND allowed by the grant."
  },
  "envelope": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "id",
        "command",
        "args"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,64}$"
        },
        "command": {
          "type": "string"
        },
        "args": {
          "type": "object"
        },
        "precondition": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "revision": {
              "type": "integer",
              "minimum": 0
            },
            "navigationId": {
              "type": "string",
              "maxLength": 64
            },
            "url": {
              "type": "string",
              "maxLength": 8192
            }
          }
        }
      }
    },
    "cancel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "cancel"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "cancel": {
          "type": "string"
        }
      }
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "v",
            "id",
            "ok",
            "result",
            "revision"
          ],
          "properties": {
            "v": {
              "const": 1
            },
            "id": {
              "type": "string"
            },
            "ok": {
              "const": true
            },
            "result": {},
            "revision": {
              "type": "integer"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "v",
            "id",
            "ok",
            "error"
          ],
          "properties": {
            "v": {
              "const": 1
            },
            "id": {
              "type": "string"
            },
            "ok": {
              "const": false
            },
            "error": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      ]
    },
    "event": {
      "type": "object",
      "required": [
        "v",
        "seq",
        "event",
        "data"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "event": {
          "type": "string"
        },
        "data": {
          "type": "object"
        }
      }
    }
  },
  "definitions": {
    "WorkspaceId": {
      "type": "string",
      "pattern": "^ws_[a-z0-9]{8,32}$"
    },
    "TabId": {
      "type": "string",
      "pattern": "^tab_[a-z0-9]{8,32}$"
    },
    "FavoriteId": {
      "type": "string",
      "pattern": "^fav_[a-z0-9]{8,32}$"
    },
    "HttpUrl": {
      "type": "string",
      "maxLength": 8192,
      "pattern": "^https?://"
    },
    "Workspace": {
      "type": "object",
      "required": [
        "id",
        "name",
        "icon",
        "profileKind",
        "agentOwned"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/WorkspaceId"
        },
        "name": {
          "type": "string",
          "maxLength": 64
        },
        "icon": {
          "type": "string",
          "enum": [
            "personal",
            "codex",
            "claude-code",
            "chatgpt",
            "agent",
            "work",
            "generic"
          ]
        },
        "profileKind": {
          "type": "string",
          "enum": [
            "personal",
            "agent-isolated",
            "private"
          ]
        },
        "agentOwned": {
          "type": "boolean"
        }
      }
    },
    "Tab": {
      "type": "object",
      "required": [
        "id",
        "workspaceId",
        "url",
        "title",
        "pinned",
        "loading",
        "active",
        "openedBy"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/TabId"
        },
        "workspaceId": {
          "$ref": "#/definitions/WorkspaceId"
        },
        "url": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "maxLength": 512
        },
        "pinned": {
          "type": "boolean"
        },
        "loading": {
          "type": "boolean"
        },
        "active": {
          "type": "boolean",
          "description": "True when this is the active tab of its window. Agents cannot change this in v1."
        },
        "openedBy": {
          "type": "string",
          "enum": [
            "user",
            "agent",
            "extension",
            "restore",
            "popup"
          ]
        },
        "navigationId": {
          "type": "string"
        },
        "crashed": {
          "type": "boolean"
        },
        "audible": {
          "type": "boolean"
        }
      }
    },
    "Favorite": {
      "type": "object",
      "required": [
        "id",
        "url",
        "title"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/FavoriteId"
        },
        "url": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "maxLength": 256
        }
      }
    },
    "Error": {
      "type": "object",
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "invalid_argument",
            "unknown_command",
            "unauthenticated",
            "permission_denied",
            "not_found",
            "precondition_failed",
            "conflict",
            "user_interaction_required",
            "rate_limited",
            "payload_too_large",
            "cancelled",
            "timeout",
            "unavailable",
            "unsupported",
            "internal"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 1024
        },
        "retryable": {
          "type": "boolean"
        },
        "pendingRequestId": {
          "type": "string",
          "description": "Present with user_interaction_required: id of the visible pending request in the authorized workspace."
        }
      }
    }
  },
  "operations": {
    "read.metadata": "List workspaces, favorites and tab URL/title/state within granted workspaces.",
    "write.organize": "Create workspaces, create/pin/close/move tabs, add favorites within granted workspaces. Never activates.",
    "read.content": "Read a bounded accessibility/text snapshot of a granted tab's page.",
    "read.capture": "Capture a screenshot of a granted tab.",
    "write.navigate": "Navigate a granted tab to an http(s) URL.",
    "write.interact": "Click/type into a granted page (planned, not in v1).",
    "write.sensitive": "Submit forms, send messages, upload files, purchase, install extensions (planned; always needs a per-action human approval)."
  },
  "commands": [
    {
      "name": "capabilities.get",
      "mcpTool": "justslide_capabilities_get",
      "title": "Get JustSlide capabilities",
      "description": "Return the protocol version, browser instance id, the commands this browser build implements that the current grant allows, and the grant's scope summary.",
      "operation": null,
      "idempotency": "safe",
      "activates": false,
      "arguments": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "result": {
        "type": "object",
        "required": [
          "protocolVersion",
          "instanceId",
          "commands",
          "grant"
        ],
        "properties": {
          "protocolVersion": {
            "type": "string"
          },
          "instanceId": {
            "type": "string"
          },
          "commands": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "grant": {
            "type": "object",
            "properties": {
              "grantId": {
                "type": "string"
              },
              "workspaces": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/WorkspaceId"
                }
              },
              "operations": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "paused": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "events": [],
      "exposure": [
        "mcp",
        "ui"
      ]
    },
    {
      "name": "workspaces.list",
      "mcpTool": "justslide_workspaces_list",
      "title": "List workspaces",
      "description": "List workspaces visible to this grant. Personal workspaces are omitted unless the user explicitly granted them.",
      "operation": "read.metadata",
      "idempotency": "safe",
      "activates": false,
      "arguments": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "result": {
        "type": "object",
        "required": [
          "workspaces"
        ],
        "properties": {
          "workspaces": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/Workspace"
            }
          }
        }
      },
      "events": [],
      "exposure": [
        "mcp",
        "ui"
      ]
    },
    {
      "name": "workspaces.create",
      "mcpTool": "justslide_workspaces_create",
      "title": "Create an agent workspace",
      "description": "Create a new agent-owned workspace in an isolated agent profile. The person's selected workspace, window and focus do not change; the new workspace appears in the dock.",
      "operation": "write.organize",
      "idempotency": "request-id",
      "activates": false,
      "arguments": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "icon": {
            "type": "string",
            "enum": [
              "agent",
              "codex",
              "chatgpt",
              "claude-code",
              "work",
              "generic"
            ],
            "default": "agent"
          }
        }
      },
      "result": {
        "type": "object",
        "required": [
          "workspace"
        ],
        "properties": {
          "workspace": {
            "$ref": "#/definitions/Workspace"
          }
        }
      },
      "events": [
        "workspace.created"
      ],
      "exposure": [
        "mcp",
        "ui"
      ]
    },
    {
      "name": "tabs.list",
      "mcpTool": "justslide_tabs_list",
      "title": "List tabs",
      "description": "List tabs in granted workspaces (optionally one workspace).",
      "operation": "read.metadata",
      "idempotency": "safe",
      "activates": false,
      "arguments": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "workspaceId": {
            "$ref": "#/definitions/WorkspaceId"
          }
        }
      },
      "result": {
        "type": "object",
        "required": [
          "tabs"
        ],
        "properties": {
          "tabs": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/Tab"
            }
          }
        }
      },
      "events": [],
      "exposure": [
        "mcp",
        "ui"
      ]
    },
    {
      "name": "tabs.create",
      "mcpTool": "justslide_tabs_create",
      "title": "Create a background tab",
      "description": "Open an http(s) URL in a new background tab of a granted workspace. Never activates the tab, window or workspace and never takes keyboard focus.",
      "operation": "write.organize",
      "idempotency": "request-id",
      "activates": false,
      "arguments": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "workspaceId",
          "url"
        ],
        "properties": {
          "workspaceId": {
            "$ref": "#/definitions/WorkspaceId"
          },
          "url": {
            "$ref": "#/definitions/HttpUrl"
          },
          "pinned": {
            "type": "boolean",
            "default": false
          },
          "activate": {
            "const": false,
            "default": false,
            "description": "Reserved. External callers cannot activate tabs in protocol v1."
          }
        }
      },
      "result": {
        "type": "object",
        "required": [
          "tab"
        ],
        "properties": {
          "tab": {
            "$ref": "#/definitions/Tab"
          }
        }
      },
      "events": [
        "tab.created"
      ],
      "exposure": [
        "mcp",
        "ui"
      ]
    },
    {
      "name": "tabs.pin",
      "mcpTool": "justslide_tabs_pin",
      "title": "Pin or unpin a tab",
      "description": "Pin or unpin a tab in a granted workspace using the browser's native pin model.",
      "operation": "write.organize",
      "idempotency": "idempotent",
      "activates": false,
      "arguments": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tabId",
          "pinned"
        ],
        "properties": {
          "tabId": {
            "$ref": "#/definitions/TabId"
          },
          "pinned": {
            "type": "boolean"
          }
        }
      },
      "result": {
        "type": "object",
        "required": [
          "tab"
        ],
        "properties": {
          "tab": {
            "$ref": "#/definitions/Tab"
          }
        }
      },
      "events": [
        "tab.updated"
      ],
      "exposure": [
        "mcp",
        "ui"
      ]
    },
    {
      "name": "tabs.close",
      "mcpTool": "justslide_tabs_close",
      "title": "Close a tab",
      "description": "Close an agent-opened tab in a granted workspace. Closing a user-opened or human-active tab returns user_interaction_required.",
      "operation": "write.organize",
      "idempotency": "idempotent",
      "activates": false,
      "arguments": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tabId"
        ],
        "properties": {
          "tabId": {
            "$ref": "#/definitions/TabId"
          }
        }
      },
      "result": {
        "type": "object",
        "required": [
          "closed"
        ],
        "properties": {
          "closed": {
            "type": "boolean"
          }
        }
      },
      "events": [
        "tab.closed"
      ],
      "exposure": [
        "mcp",
        "ui"
      ]
    },
    {
      "name": "favorites.list",
      "mcpTool": "justslide_favorites_list",
      "title": "List favorites",
      "description": "List website favorites of the granted profile.",
      "operation": "read.metadata",
      "idempotency": "safe",
      "activates": false,
      "arguments": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "result": {
        "type": "object",
        "required": [
          "favorites"
        ],
        "properties": {
          "favorites": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/Favorite"
            }
          }
        }
      },
      "events": [],
      "exposure": [
        "mcp",
        "ui"
      ]
    },
    {
      "name": "favorites.add",
      "mcpTool": "justslide_favorites_add",
      "title": "Add a favorite",
      "description": "Add an http(s) website to the favorites grid of the granted profile.",
      "operation": "write.organize",
      "idempotency": "idempotent",
      "activates": false,
      "arguments": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "$ref": "#/definitions/HttpUrl"
          },
          "title": {
            "type": "string",
            "maxLength": 256
          }
        }
      },
      "result": {
        "type": "object",
        "required": [
          "favorite"
        ],
        "properties": {
          "favorite": {
            "$ref": "#/definitions/Favorite"
          }
        }
      },
      "events": [
        "favorite.added"
      ],
      "exposure": [
        "mcp",
        "ui"
      ]
    },
    {
      "name": "page.navigate",
      "mcpTool": "justslide_page_navigate",
      "title": "Navigate a background tab",
      "description": "Navigate a granted, non-human-active tab to an http(s) URL. Navigating the person's active tab returns user_interaction_required.",
      "operation": "write.navigate",
      "idempotency": "non-idempotent",
      "activates": false,
      "arguments": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tabId",
